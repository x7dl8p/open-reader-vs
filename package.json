{
  "name": "open-reader",
  "displayName": "Open Reader",
  "description": "Native e-book reader for VS Code — read EPUB books and CBZ comics in the sidebar or the editor, local-first and private.",
  "version": "0.0.12",
  "publisher": "x7dl8p",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/x7dl8p/open-reader-vs"
  },
  "homepage": "https://open-reader-web.vercel.app/",
  "bugs": {
    "url": "https://github.com/x7dl8p/open-reader-vs/issues"
  },
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openReaderExplorer",
          "title": "Open-Reader",
          "icon": "resources/book.svg"
        }
      ]
    },
    "views": {
      "openReaderExplorer": [
        {
          "id": "openReaderLibrary",
          "name": "Library"
        },
        {
          "id": "openReaderNowReading",
          "name": "Reader",
          "type": "webview"
        }
      ]
    },
    "languages": [
      {
        "id": "openReaderProse",
        "aliases": [
          "Open Reader"
        ],
        "extensions": []
      }
    ],
    "viewsWelcome": [
      {
        "view": "openReaderLibrary",
        "contents": "No books found.\nThe workspace is scanned for .epub & .cbz files. Point at a folder of books to add them to your library.\n[Add Library Folder](command:openReader.chooseLibraryFolder)\nThe eye button in the title bar switches to browsing the project's files."
      }
    ],
    "commands": [
      {
        "command": "openReader.refreshLibrary",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Reader"
      },
      {
        "command": "openReader.chooseLibraryFolder",
        "title": "Add Folder",
        "icon": "$(folder-opened)",
        "category": "Reader"
      },
      {
        "command": "openReader.openSettings",
        "title": "Settings",
        "icon": "$(gear)",
        "category": "Reader"
      },
      {
        "command": "openReader.showFiles",
        "title": "Browse Library Files",
        "icon": "$(eye-closed)",
        "category": "Reader"
      },
      {
        "command": "openReader.showLibrary",
        "title": "Back to Book List",
        "icon": "$(eye)",
        "category": "Reader"
      },
      {
        "command": "openReader.openToc",
        "title": "Open Table of Contents",
        "category": "Reader"
      },
      {
        "command": "openReader.openChapter",
        "title": "Read in Editor Area",
        "icon": "$(layout-centered)",
        "category": "Reader"
      },
      {
        "command": "openReader.openInNowReading",
        "title": "Read in Reader Panel",
        "icon": "$(layout-sidebar-left)",
        "category": "Reader"
      },
      {
        "command": "openReader.nextChapter",
        "title": "Next Chapter",
        "icon": "$(arrow-right)",
        "category": "Reader"
      },
      {
        "command": "openReader.previousChapter",
        "title": "Previous Chapter",
        "icon": "$(arrow-left)",
        "category": "Reader"
      },
      {
        "command": "openReader.backToToc",
        "title": "Back to Table of Contents",
        "icon": "$(list-unordered)",
        "category": "Reader"
      },
      {
        "command": "openReader.showAbout",
        "title": "About",
        "icon": "$(info)",
        "category": "Reader"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "openReader.showFiles",
          "when": "view == openReaderLibrary && !openReader.fileView",
          "group": "navigation@0"
        },
        {
          "command": "openReader.showLibrary",
          "when": "view == openReaderLibrary && openReader.fileView",
          "group": "navigation@0"
        },
        {
          "command": "openReader.refreshLibrary",
          "when": "view == openReaderLibrary"
        },
        {
          "command": "openReader.chooseLibraryFolder",
          "when": "view == openReaderLibrary"
        },
        {
          "command": "openReader.openSettings",
          "when": "view == openReaderLibrary"
        },
        {
          "command": "openReader.showAbout",
          "when": "view == openReaderLibrary"
        }
      ],
      "editor/title": [
        {
          "command": "openReader.previousChapter",
          "when": "activeWebviewPanelId == openReaderReader",
          "group": "navigation@1"
        },
        {
          "command": "openReader.backToToc",
          "when": "activeWebviewPanelId == openReaderReader",
          "group": "navigation@2"
        },
        {
          "command": "openReader.nextChapter",
          "when": "activeWebviewPanelId == openReaderReader",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "openReader.openInNowReading",
          "when": "view == openReaderLibrary && viewItem == chapter",
          "group": "inline@1"
        },
        {
          "command": "openReader.openChapter",
          "when": "view == openReaderLibrary && viewItem == chapter",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "Open-Reader",
      "properties": {
        "openReader.libraryFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra folders of books to add to the library, scanned alongside the open workspace. The eye button browses the workspace's own files."
        },
        "openReader.fontFamily": {
          "type": "string",
          "enum": [
            "serif",
            "sans",
            "mono",
            "dyslexic"
          ],
          "default": "serif",
          "description": "Font used in the Reader panel."
        },
        "openReader.fontSize": {
          "type": "string",
          "enum": [
            "sm",
            "md",
            "lg",
            "xl",
            "2xl"
          ],
          "default": "md",
          "description": "Text size in the Reader panel."
        },
        "openReader.fontWeight": {
          "type": "string",
          "enum": [
            "light",
            "normal",
            "medium",
            "bold"
          ],
          "default": "normal",
          "description": "Font weight in the Reader panel."
        },
        "openReader.lineHeight": {
          "type": "string",
          "enum": [
            "tight",
            "normal",
            "relaxed",
            "loose"
          ],
          "default": "relaxed",
          "description": "Line height in the Reader panel."
        },
        "openReader.letterSpacing": {
          "type": "string",
          "enum": [
            "tight",
            "normal",
            "wide",
            "wider"
          ],
          "default": "normal",
          "description": "Letter spacing in the Reader panel."
        },
        "openReader.textAlign": {
          "type": "string",
          "enum": [
            "left",
            "justify",
            "center"
          ],
          "default": "left",
          "description": "Text alignment in the Reader panel."
        },
        "openReader.indent": {
          "type": "boolean",
          "default": true,
          "description": "Indent the first line of each paragraph instead of spacing paragraphs apart."
        },
        "openReader.showChapterNumbers": {
          "type": "boolean",
          "default": true,
          "description": "Show the chapter position (e.g. 3/24) in the Reader toolbar."
        },
        "openReader.twoPageMode": {
          "type": "boolean",
          "default": false,
          "description": "Lay out the chapter as newspaper-style columns instead of one flowing column."
        },
        "openReader.marginX": {
          "type": "number",
          "default": 34,
          "minimum": 0,
          "maximum": 500,
          "description": "Left/right padding (px) in the Reader panel."
        },
        "openReader.marginY": {
          "type": "number",
          "default": 11,
          "minimum": 0,
          "maximum": 500,
          "description": "Top/bottom padding (px) in the Reader panel."
        },
        "openReader.bgColor": {
          "type": "string",
          "default": "",
          "description": "Custom background color (hex) for the Reader panel. Empty follows the current VS Code theme."
        },
        "openReader.textColor": {
          "type": "string",
          "default": "",
          "description": "Custom text color (hex) for the Reader panel. Empty follows the current VS Code theme."
        }
      }
    },
    "configurationDefaults": {
      "[openReaderProse]": {
        "editor.fontFamily": "Georgia, 'Iowan Old Style', 'Palatino Linotype', serif",
        "editor.fontSize": 17,
        "editor.lineHeight": 30,
        "editor.wordWrap": "on",
        "editor.lineNumbers": "off",
        "editor.minimap.enabled": false,
        "editor.renderWhitespace": "none",
        "editor.overviewRulerBorder": false,
        "editor.folding": false,
        "editor.guides.indentation": false,
        "editor.occurrencesHighlight": "off",
        "editor.quickSuggestions": {
          "other": false,
          "comments": false,
          "strings": false
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/turndown": "^5.0.6",
    "@types/vscode": "1.107.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "turndown": "^7.2.4"
  }
}
