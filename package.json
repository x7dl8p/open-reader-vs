{
  "name": "book-reader",
  "displayName": "Reader",
  "description": "Native EPUB reader for VS Code",
  "version": "0.0.1",
  "publisher": "x7dl8p",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bookReaderExplorer",
          "title": "Reader",
          "icon": "resources/book.svg"
        }
      ]
    },
    "views": {
      "bookReaderExplorer": [
        {
          "id": "bookReaderLibrary",
          "name": "Library"
        },
        {
          "id": "bookReaderNowReading",
          "name": "Now Reading",
          "type": "webview"
        }
      ]
    },
    "languages": [
      {
        "id": "bookReaderProse",
        "aliases": [
          "Book Reader"
        ],
        "extensions": []
      }
    ],
    "viewsWelcome": [
      {
        "view": "bookReaderLibrary",
        "contents": "No EPUB files found.\n[Add Library Folder](command:bookReader.chooseLibraryFolder)\nBy default the current workspace folder is scanned for .epub files."
      }
    ],
    "commands": [
      {
        "command": "bookReader.refreshLibrary",
        "title": "Refresh Library",
        "icon": "$(refresh)",
        "category": "Reader"
      },
      {
        "command": "bookReader.chooseLibraryFolder",
        "title": "Add Library Folder...",
        "icon": "$(folder-opened)",
        "category": "Reader"
      },
      {
        "command": "bookReader.openSettings",
        "title": "Open Reader Settings",
        "icon": "$(gear)",
        "category": "Reader"
      },
      {
        "command": "bookReader.openToc",
        "title": "Open Table of Contents",
        "category": "Reader"
      },
      {
        "command": "bookReader.openChapter",
        "title": "Open in Editor Tab",
        "icon": "$(arrow-right)",
        "category": "Reader"
      },
      {
        "command": "bookReader.openInNowReading",
        "title": "Show in Now Reading Panel",
        "icon": "$(arrow-left)",
        "category": "Reader"
      },
      {
        "command": "bookReader.nextChapter",
        "title": "Next Chapter",
        "icon": "$(arrow-right)",
        "category": "Reader"
      },
      {
        "command": "bookReader.previousChapter",
        "title": "Previous Chapter",
        "icon": "$(arrow-left)",
        "category": "Reader"
      },
      {
        "command": "bookReader.backToToc",
        "title": "Back to Table of Contents",
        "icon": "$(list-unordered)",
        "category": "Reader"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "bookReader.refreshLibrary",
          "when": "view == bookReaderLibrary",
          "group": "navigation@1"
        },
        {
          "command": "bookReader.chooseLibraryFolder",
          "when": "view == bookReaderLibrary",
          "group": "navigation@2"
        },
        {
          "command": "bookReader.openSettings",
          "when": "view == bookReaderLibrary",
          "group": "navigation@3"
        }
      ],
      "editor/title": [
        {
          "command": "bookReader.previousChapter",
          "when": "resourceScheme == book-reader-chapter",
          "group": "navigation@1"
        },
        {
          "command": "bookReader.backToToc",
          "when": "resourceScheme == book-reader-chapter",
          "group": "navigation@2"
        },
        {
          "command": "bookReader.nextChapter",
          "when": "resourceScheme == book-reader-chapter",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "bookReader.openInNowReading",
          "when": "view == bookReaderLibrary && viewItem == chapter",
          "group": "inline@1"
        },
        {
          "command": "bookReader.openChapter",
          "when": "view == bookReaderLibrary && viewItem == chapter",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "Reader",
      "properties": {
        "bookReader.libraryFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Folders to scan for .epub files. When empty, the current workspace folder(s) are scanned."
        }
      }
    },
    "configurationDefaults": {
      "[bookReaderProse]": {
        "editor.fontFamily": "Georgia, 'Iowan Old Style', 'Palatino Linotype', serif",
        "editor.fontSize": 17,
        "editor.lineHeight": 30,
        "editor.wordWrap": "on",
        "editor.lineNumbers": "off",
        "editor.minimap.enabled": false,
        "editor.renderWhitespace": "none",
        "editor.overviewRulerBorder": false,
        "editor.folding": false,
        "editor.guides.indentation": false,
        "editor.occurrencesHighlight": "off",
        "editor.quickSuggestions": {
          "other": false,
          "comments": false,
          "strings": false
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/turndown": "^5.0.6",
    "@types/vscode": "1.107.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "turndown": "^7.2.4"
  }
}
